# Build-time, public: which NEAR network the frontend targets (mainnet or testnet).
VITE_NEAR_NETWORK=mainnet
# Server-only, optional: keyed mainnet RPC URL (https). Empty uses the free FastNEAR endpoint. Never use a VITE_ prefix.
NEAR_RPC_URL_MAINNET=
# Server-only, optional: keyed testnet RPC URL (https). Empty uses the free FastNEAR endpoint. Never use a VITE_ prefix.
NEAR_RPC_URL_TESTNET=
# Server-only (names only; set real values in Vercel/Railway, never here). See RELEASE_NEAR_SOLANA.md.

# Optional Discord webhook for server-side watchlist alert delivery.
INTENT_ALERT_WEBHOOK_URL=

# Keyed Solana mainnet RPC for launch prepare/submit/status (public RPC is the rate-limited fallback).
SOLANA_RPC_URL=
# Vercel Blob token for the private launch store (reviews, signed outbox, receipts).
BLOB_READ_WRITE_TOKEN=
# Optional 1Click partner token for NEAR Intents funding quotes (without it the provider adds 0.25%).
NEAR_INTENTS_JWT=
# Optional canonical https origin of the live site (defaults to the Vercel production URL).
APP_ORIGIN=
# Public treasury identity (server env on BOTH Vercel and Railway).
INTENT_TREASURY_ADDRESS=
# Railway ONLY: operator key matching that public treasury. Never expose via VITE_ or frontend.
INTENT_OPERATOR_PRIVATE_KEY=
# Railway ONLY: explicit enable switch after configuring/funding the treasury and reviewing release notes.
INTENT_REWARDS_ENABLED=0
# Optional server-only Jupiter key for SOL initial-buy conversion; keyless quota may be limited.
JUPITER_API_KEY=
